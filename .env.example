# Shared compose environment. Copy to .env and adjust as needed.

# --- Postgres ---
POSTGRES_DB=projectnotes
POSTGRES_USER=projectnotes
POSTGRES_PASSWORD=projectnotes
POSTGRES_PORT=5432

# --- Qdrant ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Backend ---
# development | production. production refuses default secrets and hides /docs.
ENVIRONMENT=development
# Connection string the backend uses to reach Postgres.
DATABASE_URL=postgresql+psycopg://projectnotes:projectnotes@localhost:5432/projectnotes
# Qdrant endpoint the backend uses for vectors.
QDRANT_URL=http://localhost:6333
# FastEmbed model (CPU).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Host port the backend container publishes.
BACKEND_PORT=8000
# Comma-separated CORS origins allowed by the API.
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
# Both secrets ship with insecure `-change-me` defaults; `deploy.sh vps` rotates
# them automatically on a public deploy. SERVICE_API_KEY must match between the
# backend and the mcp service (below).
SECRET_KEY=dev-insecure-change-me
SERVICE_API_KEY=dev-service-key-change-me
# Cookie hardening: set SESSION_COOKIE_SECURE=true behind TLS (deploy.sh vps --tls).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# --- MCP server ---
# Transport for the containerized MCP service: sse (default) or streamable-http.
# (Local Claude Code uses stdio directly on the host — see mcp/README.md.)
MCP_TRANSPORT=sse
# Host port the MCP container publishes (SSE endpoint at /sse).
MCP_PORT=8050
# (The MCP also reads SERVICE_API_KEY, set once under --- Auth --- above.)

# --- Frontend ---
# Browser-reachable backend URL, baked into the Next.js client bundle at build
# time. Use the host-published backend port (NOT the in-network backend:8000).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Host port the frontend container publishes.
FRONTEND_PORT=3000
