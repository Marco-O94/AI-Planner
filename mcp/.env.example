# MCP server environment. Copy to .env for local runs (or pass via the shell).

# Base URL of the ProjectNotes backend (HTTP only — the MCP never imports it).
# Local host backend (default dev port remapped to 8088 in this repo's .env):
BACKEND_URL=http://localhost:8088
# In docker-compose the backend is reachable in-network as:
# BACKEND_URL=http://backend:8000

# Transport: stdio (default, for local Claude Code) | sse | streamable-http.
MCP_TRANSPORT=stdio
# Bind host/port for sse / streamable-http transports (ignored for stdio).
# Loopback by default; set 0.0.0.0 only to expose the service on the network
# (the docker-compose mcp service sets 0.0.0.0 explicitly).
MCP_HOST=127.0.0.1
MCP_PORT=8050

# Backend HTTP timeout (seconds).
BACKEND_TIMEOUT=30

# Service key sent as X-Service-API-Key so the MCP passes the backend's auth gate.
# Must equal the backend's SERVICE_API_KEY. Empty/unset = no header (pre-auth backends).
SERVICE_API_KEY=dev-service-key-change-me
