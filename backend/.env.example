# Backend environment. Copy to .env for local (non-docker) runs.
# development | production. production refuses default secrets and hides /docs.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://projectnotes:projectnotes@localhost:5432/projectnotes
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Comma-separated CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000

# --- Auth (insecure defaults; deploy.sh vps rotates SECRET_KEY + SERVICE_API_KEY) ---
SECRET_KEY=dev-insecure-change-me
# Static key the MCP service sends as X-Service-API-Key to reach gated routes.
SERVICE_API_KEY=dev-service-key-change-me
# Session cookie: set SESSION_COOKIE_SECURE=true behind TLS.
SESSION_TTL_SECONDS=1209600
SESSION_COOKIE_NAME=ai_planner_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
